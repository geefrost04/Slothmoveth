{
  "name": "slothmove-platform",
  "version": "0.1.0",
  "private": true,
  "description": "SlothMove — Config-driven Next.js platform for multi-course learning (Phase 2 of the lean architecture)",
  "scripts": {
    "dev": "next dev -p 3040",
    "prebuild": "npm run verify:mock-route",
    "build": "next build",
    "start": "next start -p 3040",
    "clean": "rm -rf .next",
    "lint": "next lint",
    "content:import:study-sheet": "node scripts/import-study-sheet.mjs",
    "content:validate:study-sheet": "node scripts/import-study-sheet.mjs --validate-only",
    "content:seed:study-sheet": "node scripts/generate-study-sheet-seed.mjs",
    "content:create:police-mini-mock": "node scripts/create-police-mini-mock-set.mjs",
    "verify:mock-route": "node scripts/verify-mock-test-route.mjs",
    "commerce:audit": "node scripts/migrate-stripe-live-products.mjs --dry-run",
    "commerce:migrate:live": "node scripts/migrate-stripe-live-products.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.0",
    "@supabase/supabase-js": "^2.45.0",
    "next": "^15.5.19",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "stripe": "^22.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.6.0"
  }
}
